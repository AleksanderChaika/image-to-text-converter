# Порт сервера (по умолчанию 3000)
PORT=3000
# Дополнительные разрешённые origin для CORS через запятую (необязательно).
# Локальные http://localhost, 127.0.0.1 и [::1] на любом порту разрешены всегда.
CORS_ORIGINS=
# Авторизация в Google Cloud выполняется через ADC: gcloud auth application-default login
