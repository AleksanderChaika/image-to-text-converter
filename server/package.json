{
  "name": "image-to-text-converter-server",
  "version": "1.0.0",
  "private": true,
  "description": "OCR backend for Image to Text Converter (Express + Google Cloud Vision)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/vision": "^6.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
